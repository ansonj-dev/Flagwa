APP_NAME=FLAGWA Backend
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
API_PORT=8000

# Replace the placeholders locally; URL-encode special characters in passwords.
DATABASE_URL=postgresql+psycopg://flagwa:REPLACE_LOCALLY@localhost:5432/flagwa
DOCKER_DATABASE_URL=postgresql+psycopg://flagwa:REPLACE_LOCALLY@postgres:5432/flagwa
POSTGRES_PASSWORD=
REDIS_URL=redis://localhost:6379/0

EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# Preserve support for the existing download script. Token takes precedence.
EARTHDATA_TOKEN=

BHOONIDHI_ENABLED=false
BHOONIDHI_USERNAME=
BHOONIDHI_PASSWORD=

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ADMIN_API_KEY=

AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

PROVIDER_TIMEOUT_SECONDS=60
ASF_CDN_HOSTS=d1mv8zhcvry6x4.cloudfront.net
MAX_DOWNLOAD_BYTES=50000000000
MAX_PROCESSING_PIXELS=16000000
MIN_FREE_DISK_BYTES=1000000000
MAX_REQUEST_BYTES=1048576
EXPENSIVE_REQUESTS_PER_MINUTE=20
LIVE_PROVIDER_TESTS=false